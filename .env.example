AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_SPEECH_MODEL_ID=amazon.nova-2-sonic-v1:0
# Nova Sonic's bidirectional API requires valid standard SigV4 credentials;
# AWS_BEARER_TOKEN_BEDROCK works for Claude/Converse but not Nova Sonic.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
DEEPGRAM_API_KEY=
GBRAIN_MCP_URL=https://gbrain.io/mcp
GBRAIN_MCP_TOKEN=
GBRAIN_API_KEY=
MEMORABLE_API_KEY=
MEMORABLE_API_URL=https://memorable-extraction-api.memorable.workers.dev
MEMORABLE_ENVIRONMENT_ID=
MEMORABLE_BACKEND=qm
MEMORABLE_NO_KEYCHAIN=1
MEMORABLE=0
MEMORABLE_CONSENT=deny
USE_LOCAL_FALLBACKS=true   # if true, write brain + traces locally as well
