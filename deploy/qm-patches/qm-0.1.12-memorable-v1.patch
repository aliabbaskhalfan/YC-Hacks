+  assert.equal(captures[0]?.completed, true);
+  assert.ok(Number.isSafeInteger(captures[0]?.turnUserSeq));
+  assert.ok(captures[0]!.turnEndSeq! < captures[1]!.turnUserSeq!, "intervals own distinct persisted tasks");
+  g.release();
+  await new Promise((resolve) => setImmediate(resolve));
+  g.release();
+});
