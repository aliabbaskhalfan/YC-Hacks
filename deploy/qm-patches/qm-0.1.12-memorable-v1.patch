+  const memory: MemoryService = {
+    recall: async () => "", read: async () => "NOTEBOOK_KEEP", query: async () => [], replace: async () => {}, capture: async () => 0,
+    recallSupplemental: async (scope, context) => { rendered.push({ scope, query: context.query }); return "PROCEDURE_REFERENCE"; },
+    captureTurn: async (_scope, context) => { captures.push(context); return 1; },
+  };
+  const baseRun = g.harness.turns.runTurn.bind(g.harness.turns);
+  const harness: Harness = { ...g.harness, turns: { ...g.harness.turns,
+    runTurn: async (input) => { sent.push(input.environment ?? ""); return baseRun(input); },
+  } };
+  const strategy = createPerTurnStrategy({ memory, harness: harness.models });
+  const orch = buildOrchestrator(harness, memory, strategy);
+  const one = await orch.handleTurn(dm("dm:U1:native", "first native task"));
+  const two = await orch.handleTurn(dm("dm:U1:native", "second native task"));
+  assert.equal(one.status, "ok");
+  assert.equal(two.status, "ok");
+  assert.equal(g.finished, 0, "factual extraction remains gated");
+  assert.ok(rendered.some((row) => row.query === "first native task"));
+  assert.ok(rendered.some((row) => row.query === "second native task"));
+  assert.equal(sent.length, 2);
