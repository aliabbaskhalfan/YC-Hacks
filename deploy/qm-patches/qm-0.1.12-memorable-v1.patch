+    type, payload, scopeLabel: scope, createdAt: i } as SessionEntry));
+}
+function boundary(start = 10): MemoryCaptureContext {
+  return { mode: "automatic", sessionId: "session", conversationScopeId: TEAM, actorId: "alice",
+    completed: true, turnUserSeq: start, turnEndSeq: start + 5, idempotencyKey: `run-${start}` };
